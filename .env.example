NODE_ENV=development
APP_NAME=Delyra
APP_VERSION=1.0.0
APP_URL=http://localhost:3000

POSTGRES_DB=sales_lifecycle
POSTGRES_USER=sales_lifecycle
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=55434
DATABASE_URL=postgresql://sales_lifecycle:change-this-local-password@localhost:55434/sales_lifecycle?schema=public

AUTH_SECRET=replace-with-at-least-32-random-bytes
SESSION_TTL_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=/app/storage
MAX_UPLOAD_BYTES=52428800

SEED_OUTPUT_TEMP_PASSWORDS=false

